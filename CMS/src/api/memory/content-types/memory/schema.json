{
  "kind": "collectionType",
  "collectionName": "memories",
  "info": {
    "singularName": "memory",
    "pluralName": "memories",
    "displayName": "Воспоминания"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "Full_name": {
      "type": "string",
      "required": true
    },
    "Graduate_year": {
      "type": "integer",
      "required": true,
      "min": 1930
    },
    "Section": {
      "type": "enumeration",
      "enum": [
        "История класса",
        "Люди девятки"
      ]
    },
    "Story": {
      "type": "text",
      "minLength": 500,
      "maxLength": 2000,
      "required": true
    },
    "Photo": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": [
        "images"
      ]
    }
  }
}
