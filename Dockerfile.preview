# Используем Node.js 18 Alpine
FROM node:18-alpine

# Устанавливаем рабочую директорию
WORKDIR /app

# Копируем файлы зависимостей
COPY package*.json ./

# Устанавливаем зависимости
RUN npm ci

# Копируем исходный код
COPY . .

# Собираем приложение
RUN npm run build

# Открываем порт 4173 (стандартный порт для Vite preview)
EXPOSE 4173

# Запускаем preview сервер
CMD ["npm", "run", "preview", "--", "--host", "0.0.0.0", "--port", "4173"] 